# Paper mode needs none of these. They are read from the process environment,
# so nothing loads this file for you. "Going live" in the README shows how.

# Polymarket US API key, from polymarket.us/developer. Live mode only.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Open-Meteo commercial key. The free tier is non-commercial, so live mode
# refuses to start without this.
OPEN_METEO_API_KEY=
